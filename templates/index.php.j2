<!DOCTYPE html>
<html>
<head>
    <!-- Render the title from an Ansible variable -->
    <title>{{ website_title }}</title>
    <meta charset="UTF-8">
</head>
<body>
    <!-- Render the main message from an Ansible variable -->
    <h1>{{ website_message }}</h1>

    <h2>LAMP Stack Information</h2>

    <?php
        // Display a confirmation that PHP is being interpreted.
        echo "<h3>PHP is working successfully!</h3>";

        // Display the installed PHP version.
        echo "PHP Version: " . htmlspecialchars(phpversion(), ENT_QUOTES, 'UTF-8');
    ?>

    <hr>
    <h2>Server Information</h2>

    <?php
        // Display the web server hostname.
        echo "Server Name: " .
             htmlspecialchars($_SERVER['SERVER_NAME'] ?? 'Unknown', ENT_QUOTES, 'UTF-8');

        echo "<br>";

        // Display the server software string.
        echo "Server Software: " .
             htmlspecialchars($_SERVER['SERVER_SOFTWARE'] ?? 'Unknown', ENT_QUOTES, 'UTF-8');
    ?>
</body>
</html>
